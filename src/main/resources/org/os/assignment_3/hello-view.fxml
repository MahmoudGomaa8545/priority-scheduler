<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.os.assignment_3.HelloController">
  <children>
    <!-- Input Fields -->
    <Label layoutX="42.0" layoutY="13.0" text="Process Name:">
      <font>
        <Font name="Times New Roman" size="15.0" />
      </font>
    </Label>
    <TextField fx:id="processNameField" layoutX="35.0" layoutY="45.0" prefHeight="26.0" prefWidth="181.0" promptText="e.g., P1" />
    <Label layoutX="42.0" layoutY="82.0" text="Color:">
      <font>
        <Font name="Times New Roman" size="15.0" />
      </font>
    </Label>
    <ColorPicker fx:id="colorPicker" layoutX="35.0" layoutY="115.0" prefHeight="26.0" prefWidth="182.0" />
    <Label layoutX="42.0" layoutY="157.0" text="Arrival Time:">
      <font>
        <Font name="Times New Roman" size="15.0" />
      </font>
    </Label>
    <TextField fx:id="arrivalTimeField" layoutX="35.0" layoutY="185.0" prefHeight="26.0" prefWidth="182.0" />
    <Label layoutX="42.0" layoutY="225.0" text="Burst Time:">
      <font>
        <Font name="Times New Roman" size="15.0" />
      </font>
    </Label>
    <TextField fx:id="burstTimeField" layoutX="35.0" layoutY="252.0" prefHeight="26.0" prefWidth="182.0" />
    <Label layoutX="42.0" layoutY="297.0" text="Priority:">
      <font>
        <Font name="Times New Roman" size="15.0" />
      </font>
    </Label>
    <TextField fx:id="priorityField" layoutX="35.0" layoutY="324.0" prefHeight="26.0" prefWidth="182.0" />
    <Button layoutX="35.0" layoutY="375.0" mnemonicParsing="false" onAction="#onClickAddProcess" prefHeight="26.0" prefWidth="182.0" text="Add Process" />

    <!-- Context Switching -->
    <Label layoutX="42.0" layoutY="420.0" text="Context Switching:" />
    <TextField fx:id="contextswitching" layoutX="35.0" layoutY="450.0" prefHeight="26.0" prefWidth="182.0" />
    <Label layoutX="42.0" layoutY="490.0" text="Number of Processes:" />
    <TextField fx:id="processNum" layoutX="35.0" layoutY="520.0" prefHeight="26.0" prefWidth="182.0" />
    <Button layoutX="35.0" layoutY="570.0" mnemonicParsing="false" onAction="#onClickStartProcess" prefHeight="26.0" prefWidth="182.0" text="Start Scheduling" />

    <!-- Gantt Chart -->
    <VBox fx:id="ganttChartVBox" layoutX="250.0" layoutY="20.0" prefHeight="500.0" prefWidth="1120.0" />

    <!-- Process Table -->
    <TableView fx:id="processTable" layoutX="35.0" layoutY="620.0" prefHeight="300.0" prefWidth="600.0">
      <columns>
        <TableColumn fx:id="nameColumn" text="Name" />
        <TableColumn fx:id="colorColumn" text="Color" />
        <TableColumn fx:id="arrivalColumn" text="Arrival Time" />
        <TableColumn fx:id="burstColumn" text="Burst Time" />
        <TableColumn fx:id="startColumn" text="Start Time" />
        <TableColumn fx:id="completeColumn" text="Completion Time" />
        <TableColumn fx:id="priorityColumn" text="Priority" />
      </columns>
    </TableView>

    <!-- Report -->
    <TextArea fx:id="reportTextArea" layoutX="650.0" layoutY="620.0" prefHeight="300.0" prefWidth="600.0" promptText="Scheduling Report will appear here..." />
  </children>
</AnchorPane>